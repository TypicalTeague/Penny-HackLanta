# Photon Spectrum Cloud
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_ATTEMPTS=2

# Auth0 Device Authorization (Native Application; no client secret)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://penny.example/api

# Replit PostgreSQL
DATABASE_URL=

# Runtime: imessage in production; terminal is diagnostics only
PENNY_TRANSPORT=imessage
PENNY_INTERPRETER=gemini
CONSENT_VERSION=2026-10-11
PENNY_SCHEDULER_INTERVAL_MS=3600000
PENNY_UPDATE_DELAY_MS=30000
# Optional Replit health endpoint; this is not a product UI.
PORT=3000
LOG_LEVEL=info
