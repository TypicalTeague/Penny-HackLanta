# Photon Spectrum Cloud
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_ATTEMPTS=2

# Auth0 Device Authorization (Native Application; no client secret)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://penny.example/api

# Brokerage: none for diagnostics, alpaca for the genuine sandbox, fake only
# for automated tests or explicitly labelled local development.
PENNY_BROKERAGE_PROVIDER=alpaca
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=
# Reuse a clearly fictional sandbox account when available.
ALPACA_DEMO_ACCOUNT_ID=
ALPACA_DEMO_ACH_RELATIONSHIP_ID=
# Optional server-only JSON for explicitly creating a fictional sandbox account.
ALPACA_DEMO_ACCOUNT_APPLICATION_JSON=

# Replit PostgreSQL
DATABASE_URL=

# Runtime: imessage in production; terminal is diagnostics only
PENNY_TRANSPORT=imessage
PENNY_INTERPRETER=gemini
CONSENT_VERSION=2026-10-11
PENNY_SCHEDULER_INTERVAL_MS=3600000
PENNY_UPDATE_DELAY_MS=30000
# Optional Replit health endpoint; this is not a product UI.
PORT=3000
LOG_LEVEL=info
